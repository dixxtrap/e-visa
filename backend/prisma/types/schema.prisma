datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["omitApi"]
  output   = "types"
}

// TODO: Login
model Login {
  id       Int        @id @default(autoincrement())
  type     LoginEnum
  username String
  password String
  user     User[]
  Customer Customer[]
  Role     Role?      @relation(fields: [roleId], references: [id])
  roleId   Int?

  @@unique([type, username])
  @@index([type])
  @@map("login")
}

model Icon {
  id   Int    @id @default(autoincrement())
  path String
  code String

  @@map("icon")
}

// TODO: Customer
model Customer {
  id                Int           @id @default(autoincrement())
  displayname       String
  dateOfBirth       String
  selfPath          String
  passportPath      String
  passportReference String
  passportValidity  DateTime
  address           String
  latitude          String
  longitude         String
  email             String
  login             Login         @relation(fields: [loginId], references: [id])
  activity          Activity      @relation(fields: [activityId], references: [id])
  activityId        Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  VisaRequest       VisaRequest[]
  loginId           Int

  @@map("customer")
}

// TODO: Passport

// TODO: ContactInfo
model contactInfo {
  id            Int          @id @default(autoincrement())
  displayname   String
  phone         String
  customerId    Int?
  VisaRequest   VisaRequest? @relation(fields: [visaRequestId], references: [id])
  visaRequestId Int?
}

// TODO: User
model RoadTripInfo {
  id            Int      @id @default(autoincrement())
  motif         String
  arrivalFrom   String
  arrivalDate   DateTime
  arrivalBy     Location @relation(name: "arrivalBy", fields: [arrivalById], references: [id])
  arrivalById   Int
  departureBy   Location @relation(name: "departureBy", fields: [departureToId], references: [id])
  departureTo   String
  departureDate DateTime
  departureToId Int

  locationId  Int?
  VisaRequest VisaRequest[]
}

// TODO: User
model User {
  id          Int    @id @default(autoincrement())
  displayname String
  phone       String
  email       String

  companyId Int?

  gymId   Int?
  login   Login? @relation(fields: [loginId], references: [id])
  loginId Int?

  @@map("user")
}

// TODO: Role

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @updatedAt
  comment        String?
  byId           Int?
  isActive       Boolean          @default(true)
  RolePermission RolePermission[]
  Login          Login[]

  @@map("role")
}

// TODO: RolePermission
model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  roleId       Int
  permissionId Int

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// TODO: Permission

model Permission {
  id       Int                  @id @default(autoincrement())
  code     String               @unique
  comment  String?
  module   Module               @relation(fields: [moduleId], references: [id])
  moduleId Int
  action   PermissionActionEnum

  byId           Int?
  RolePermission RolePermission[]

  @@map("permission")
}

// TODO: Module

model Module {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  Permission Permission[]

  @@map("module")
}

// TODO: Activity
model Activity {
  id   Int    @id @default(autoincrement())
  name String @unique

  isActive Boolean    @default(false)
  Customer Customer[]

  @@map("activity")
}

// TODO: VisaType
model VisaType {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  comment     String
  isActive    Boolean       @default(false)
  VisaRequest VisaRequest[]

  @@map("visa_type")
}

// TODO: VisaType
model VisaRequest {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  contacts       contactInfo[]
  visaType       VisaType      @relation(fields: [visaTypeId], references: [id])
  isActive       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  customer       Customer      @relation(fields: [customerId], references: [id])
  roadTrip       RoadTripInfo  @relation(fields: [roadTripInfoId], references: [id])
  visaTypeId     Int
  roadTripInfoId Int
  customerId     Int

  @@map("visa_request")
}

// TODO: Location
model Location {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  isActive       Boolean        @default(false)
  locationType   LocationType   @relation(fields: [locationTypeId], references: [id])
  locationTypeId Int
  departureBy    RoadTripInfo[] @relation("departureBy")
  arrivalBy      RoadTripInfo[] @relation("arrivalBy")

  @@map("location")
}

// TODO: locationType
model LocationType {
  id   Int    @id @default(autoincrement())
  name String @unique

  isActive Boolean    @default(false)
  Location Location[]

  @@map("location_type")
}

