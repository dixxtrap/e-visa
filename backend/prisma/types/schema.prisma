// Enumeration==============================================================
enum PermissionActionEnum {
  ALL
  CREATE
  READ
  UPDATE
  DETAILS
  SELF
}

enum EntityEnum {
  Company
  Customer
  Gym
}

enum CardRequestEnum {
  PENDING
  ACCEPTED
  REFUSED
}

enum LoginEnum {
  CUSTOMER
  USER
}
