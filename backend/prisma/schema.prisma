datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["rhel-openssl-1.0.x"]
}

// previewFeatures = ["omitApi"]
// TODO: LOGIN

model Login {
  id         Int       @id @default(autoincrement())
  type       LoginEnum
  username   String    @unique
  password   String
  user       User?     @relation(name: "login_to_user")
  customer   Customer? @relation(name: "CustomerToLogin")
  role       Role?     @relation(name: "LoginToRole", fields: [roleId], references: [id])
  roleId     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(false)
  isBlocked  Boolean   @default(false)
  isArchived Boolean   @default(false)
  Opt        Opt[]

  @@unique([type, username])
  @@index([type])
  @@map("login")
}

model Asset {
  id      Int           @id @default(autoincrement())
  path    String?
  code    String
  comment String?       @db.TinyText
  type    AssetTypeEnum @default(TEXT)

  @@unique([type, code])
  @@map("assets")
}

// TODO: CUSTOMER

model Customer {
  displayname String
  dateOfBirth DateTime?
  address     String?
  phone       String?
  latitude    Decimal?      @default(0.0)
  longitude   Decimal?      @default(0.0)
  email       String
  login       Login         @relation(name: "CustomerToLogin", fields: [loginId], references: [id])
  loginId     Int           @id
  activity    Activity?     @relation(name: "ActivityToCustomer", fields: [activityId], references: [id])
  activityId  Int?
  application Application[] @relation(name: "customer_to_visa_application")

  @@map("customer")
}

// TODO: PASSPORT

model Passport {
  id          Int           @id @default(autoincrement())
  selfPath    String
  path        String
  reference   String
  validity    DateTime
  birthdate   DateTime
  displayname String
  customerid  Int
  application Application[]
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @updatedAt

  @@map("passport")
}

// TODO: CONTACT_INFO

model ContactInfo {
  id            Int          @id @default(autoincrement())
  displayname   String
  phone         String
  customerId    Int?
  application   Application? @relation(name: "visa_application_to_contact_info", fields: [applicationId], references: [id])
  applicationId Int?

  @@map("contact_info")
}

// TODO: ROAD_TRIP_INFO

model RoadTripInfo {
  id                               Int         @id @default(autoincrement())
  motif                            String
  arrivalFrom                      String
  arrivalDate                      DateTime
  arrivalLocationType              String?
  arrivalLocationCompanyName       String?
  arrivalLocationCompanyIdentify   String?
  departureTo                      String?
  departureDate                    DateTime?
  departureLocationType            String?
  departureLocationCompanyName     String?
  departureLocationCompanyIdentify String?
  address                          String?
  application                      Application @relation(name: "visa_application_to_road_tripInfo", fields: [applicationId], references: [id])
  applicationId                    Int         @unique

  @@map("road_trip_info")
}

// TODO: USER

model User {
  login       Login   @relation(name: "login_to_user", fields: [loginId], references: [id])
  loginId     Int     @id
  displayname String
  phone       String
  email       String
  address     String?

  @@map("user")
}

// TODO: ROLE

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @updatedAt
  comment        String?
  byId           Int?
  isActive       Boolean          @default(true)
  rolePermission RolePermission[] @relation(name: "RoleToRolePermission")
  login          Login[]          @relation(name: "LoginToRole")

  @@map("role")
}

// TODO: RolePermission

model RolePermission {
  role         Role       @relation(name: "RoleToRolePermission", fields: [roleId], references: [id])
  permission   Permission @relation(name: "PermissionToRolePermission", fields: [permissionId], references: [id])
  roleId       Int
  permissionId Int

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model Opt {
  id        Int             @id @default(autoincrement())
  code      String
  to        Login?          @relation(fields: [loginId], references: [id])
  loginId   Int?
  staus     OptStatusEnum   @default(PENDING)
  duration  OptDurationEnum @default(MIN_15)
  createdAt DateTime?       @default(now())
  updatedAt DateTime?       @updatedAt
  via       OptSendViaEnum

  @@map("opt")
}

// TODO: Permission

model Permission {
  id             Int                  @id @default(autoincrement())
  code           String
  comment        String?
  module         Module               @relation(name: "ModuleToPermission", fields: [moduleId], references: [id])
  moduleId       Int
  action         PermissionActionEnum
  byId           Int?
  rolePermission RolePermission[]     @relation(name: "PermissionToRolePermission")

  @@unique([code, moduleId])
  @@map("permission")
}

// TODO: Module

model Module {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  permission Permission[] @relation(name: "ModuleToPermission")

  @@map("module")
}

// TODO: Activity

model Activity {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  isActive Boolean    @default(false)
  customer Customer[] @relation(name: "ActivityToCustomer")

  @@map("activity")
}

// TODO: VisaType

model VisaType {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  comment     String
  isActive    Boolean       @default(true)
  amount      Decimal
  application Application[] @relation(name: "visa_request_to_visa_type")
  byId        Int?
  createdAt   DateTime?     @default(now())
  updatedAt   DateTime?     @updatedAt

  @@map("visa_type")
}

// TODO: VisaType

model Application {
  id           Int             @id @default(autoincrement())
  phone        String?
  email        String?
  address      String?
  activity     String?
  contacts     ContactInfo[]   @relation(name: "visa_application_to_contact_info")
  visaType     VisaType?       @relation(name: "visa_request_to_visa_type", fields: [visaTypeId], references: [id])
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  status       ApplicationEnum @default(PENDING)
  customer     Customer?       @relation(name: "customer_to_visa_application", fields: [customerId], references: [loginId])
  roadTripInfo RoadTripInfo?   @relation(name: "visa_application_to_road_tripInfo")
  visaTypeId   Int?
  passport     Passport?       @relation(fields: [passportid], references: [id])
  passportid   Int?
  customerId   Int?

  @@map("application")
}

