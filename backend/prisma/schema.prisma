enum ApplicationEnum {
  PENDING
  REFUSED
  ACCEPTED
  CLOSED
}

enum PermissionActionEnum {
  MANAGE
  CREATE
  READ
  UPDATE
  DETAILS
  SELF
}

enum EntityEnum {
  Company
  Customer
  Gym
}

enum CardRequestEnum {
  PENDING
  ACCEPTED
  REFUSED
}

enum AssetTypeEnum {
  TEXT
  IMAGE
}

enum LoginEnum {
  CUSTOMER
  USER
}

enum OptDurationEnum {
  MIN_15
  MIN_30
  HOUR_1
  HOUR_4
  HOUR_12
  DAY_1
  DAY_30
  INFINY
}

enum OptSendViaEnum {
  SMS
  MAIL
}

enum OptStatusEnum {
  PENDING
  SENT
  VERIFIED
  EXPIRED
}
